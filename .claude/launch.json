{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use 26 >/dev/null && exec npm run dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-npm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "dev-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:lan"],
      "port": 5173
    },
    {
      "name": "style-frame",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--bind",
        "127.0.0.1",
        "--directory",
        "design/style-frame"
      ],
      "port": 5180
    }
  ]
}
